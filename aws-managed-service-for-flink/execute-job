#/bin/bash
FILENAME=`echo $1 | awk -F'/' '{ print $NF }'`;
ACCESS_KEY_ID=`aws configure get aws_access_key_id --profile $2`;
SECRET_ACCESS_KEY=`aws configure get aws_secret_access_key --profile $2`;
REGION=`aws configure get region --profile $2`;
echo $FILENAME;
docker cp $1 flink-standalone:/opt/flink/$FILENAME;
docker exec -it flink-standalone bash -c "AWS_ACCESS_KEY_ID='$ACCESS_KEY_ID' AWS_SECRET_ACCESS_KEY='$SECRET_ACCESS_KEY' AWS_REGION='$REGION' flink run -py /opt/flink/$FILENAME";