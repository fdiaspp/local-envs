#/bin/bash

docker images | grep flink-py311 2>&1 > /dev/null || docker build -t flink-py311:1.20 .;
docker start flink-standalone 2> /dev/null || \
docker run --name flink-standalone --restart unless-stopped -d \
    -p 8081:8081 \
    -v ~/.aws:/root/.aws \
    flink-py311:1.20 \
    bash -lc "start-cluster.sh && tail -f /dev/null"